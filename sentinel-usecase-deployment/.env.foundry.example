# Work-laptop profile. Copy to .env only after your organization approves the endpoint and model.
# No OpenAI API key is required. Authentication uses the signed-in Microsoft Entra identity.
SENTINEL_LLM_PROVIDER=azure_foundry
SENTINEL_OPENAI_API_KEY=
SENTINEL_FOUNDRY_ENDPOINT=https://<foundry-resource>.openai.azure.com/openai/v1/
SENTINEL_FOUNDRY_MODEL=<model-deployment-name>
SENTINEL_OPENAI_TIMEOUT_SECONDS=60
SENTINEL_OPENAI_MAX_RETRIES=2

# Replace with the work-approved Sentinel target.
SENTINEL_RESOURCE_GROUP=<work-resource-group>
SENTINEL_WORKSPACE=<work-log-analytics-workspace>
SENTINEL_SUBSCRIPTION_ID=<work-subscription-guid>
SENTINEL_DEPLOYMENT_SCRIPT=<path-to-Deploy-SentinelUseCases.ps1>
SENTINEL_POWERSHELL_EXECUTABLE=pwsh
SENTINEL_MANAGED_IDENTITY=false
SENTINEL_GENERATED_RULES_DIRECTORY=generated-rules
SENTINEL_LOG_LEVEL=INFO
