# MacBook development profile. Copy to .env only on a machine where direct OpenAI use is permitted.
SENTINEL_LLM_PROVIDER=openai
SENTINEL_OPENAI_API_KEY=
SENTINEL_OPENAI_MODEL=gpt-5-mini
SENTINEL_OPENAI_TIMEOUT_SECONDS=60
SENTINEL_OPENAI_MAX_RETRIES=2

# Use the lab values for local development, or replace with an approved target.
SENTINEL_RESOURCE_GROUP=rg-surya-sentinel-lab
SENTINEL_WORKSPACE=law-surya-sentinel-lab
SENTINEL_SUBSCRIPTION_ID=
SENTINEL_DEPLOYMENT_SCRIPT=
SENTINEL_POWERSHELL_EXECUTABLE=pwsh
SENTINEL_MANAGED_IDENTITY=false
SENTINEL_GENERATED_RULES_DIRECTORY=generated-rules
SENTINEL_LOG_LEVEL=INFO
