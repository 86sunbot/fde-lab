# Never commit a real API key. Leave blank for --offline-reference mode.
SENTINEL_LLM_PROVIDER=openai
SENTINEL_OPENAI_API_KEY=
SENTINEL_OPENAI_MODEL=gpt-5-mini
# Required for the future azure_foundry provider; keep blank for local OpenAI/offline mode.
SENTINEL_FOUNDRY_ENDPOINT=
SENTINEL_FOUNDRY_MODEL=
SENTINEL_OPENAI_TIMEOUT_SECONDS=60
SENTINEL_OPENAI_MAX_RETRIES=2
# Replace these lab defaults with the approved work subscription targets.
SENTINEL_RESOURCE_GROUP=rg-surya-sentinel-lab
SENTINEL_WORKSPACE=law-surya-sentinel-lab
SENTINEL_SUBSCRIPTION_ID=
# Optional: absolute path to your local Deploy-SentinelUseCases.ps1.
# The application also checks its known project/external locations.
SENTINEL_DEPLOYMENT_SCRIPT=
SENTINEL_POWERSHELL_EXECUTABLE=pwsh
SENTINEL_MANAGED_IDENTITY=false
SENTINEL_GENERATED_RULES_DIRECTORY=generated-rules
SENTINEL_LOG_LEVEL=INFO
